{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "EXAMPLE_FLAG": "1"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/home/someone/.claude/notify.mjs\" stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/home/someone/.claude/guard.mjs\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File \"C:\\home\\someone\\.claude\\statusline.ps1\""
  },
  "defaultShell": "powershell",
  "enabledPlugins": {
    "gvt-dev@gvt-plugins": true
  }
}
